# Vorlage für die lokale Entwicklung.
# Zum Starten: cp .env.example .env
# und bei Bedarf eigene Werte eintragen. .env wird nie eingecheckt.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saas

# Eigentümer der Datenbank-Tabellen. Nur für Migrationen -- läuft im
# Betrieb nie mit den Fachdaten selbst zusammen.
POSTGRES_USER=saas
POSTGRES_PASSWORD=bitte-aendern

# Eingeschränkte Rolle für den laufenden Betrieb (Migration 0001).
APP_DB_USER=app
APP_DB_PASSWORD=bitte-aendern

# Welche App gerade läuft (werkstatt, energieberater, sachverstaendige).
# Steuert z. B., ob der Werkstatt-Rollen-Umschalter existiert. Für den
# Produktivbetrieb (docker-compose.prod.yml) auf eine echte Branche setzen --
# "werkstatt" startet dort absichtlich nicht (Phase 3).
APP_NAME=werkstatt

# --- Nur für den Produktivbetrieb (docker-compose.prod.yml) ---

# Domain der Installation, z. B. eb.deine-domain.de. Caddy holt dafür
# automatisch ein HTTPS-Zertifikat. Für einen lokalen Test: localhost.
DOMAIN=localhost
# E-Mail-Adresse für die Zertifikatsstelle (Let's Encrypt), nur Hinweise bei
# Problemen, keine Werbung.
ACME_EMAIL=admin@example.com

# Wohin das tägliche Backup zusätzlich kopiert wird (rsync-Ziel, z. B. ein
# per sshfs/rclone eingebundener Ordner oder ein anderer Server). Leer lassen,
# wenn es nur lokal in ./backups liegen soll.
BACKUP_ZIEL=
# Wie viele Tage lokale Backups aufbewahrt werden, ältere werden gelöscht.
BACKUP_AUFBEWAHRUNG_TAGE=14
# Optional: Backups verschlüsseln (age). Hier nur der ÖFFENTLICHE Schlüssel
# (beginnt mit age1...). Der private Schlüssel gehört nicht auf den Server.
# Leer lassen = unverschlüsselt.
BACKUP_VERSCHLUESSELUNG_SCHLUESSEL=
