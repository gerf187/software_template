# Vorlage für die lokale Entwicklung.
# Zum Starten: cp .env.example .env
# und bei Bedarf eigene Werte eintragen. .env wird nie eingecheckt.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saas

# Eigentümer der Datenbank-Tabellen. Nur für Migrationen -- läuft im
# Betrieb nie mit den Fachdaten selbst zusammen.
POSTGRES_USER=saas
POSTGRES_PASSWORD=bitte-aendern

# Eingeschränkte Rolle für den laufenden Betrieb (Migration 0001).
APP_DB_USER=app
APP_DB_PASSWORD=bitte-aendern

# Welche App gerade läuft (werkstatt, energieberater, sachverstaendige).
# Steuert z. B., ob der Werkstatt-Rollen-Umschalter existiert.
APP_NAME=werkstatt
