# Vorlage für die Datei .env. Zum Anlegen: cp .env.example .env
# Danach die Werte anpassen. Die Datei .env wird nie ins Git-Repository
# hochgeladen und enthält Passwörter.
#
# Teil 1 (oben): für die lokale Entwicklung und den Server gleich.
# Teil 2 (unten): nur für den Server. Lokal dürfen sie leer bleiben.

# ---------- Teil 1: Datenbank und Programm ----------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saas

# Eigentümer der Datenbank-Tabellen. Nur für Migrationen -- läuft im
# Betrieb nie mit den Fachdaten selbst zusammen.
# Auf dem Server: ein langes, zufälliges Passwort (mindestens 24 Zeichen).
POSTGRES_USER=saas
POSTGRES_PASSWORD=bitte-aendern

# Eingeschränkte Rolle für den laufenden Betrieb (Migration 0001).
# Auf dem Server: ein eigenes, langes, zufälliges Passwort.
APP_DB_USER=app
APP_DB_PASSWORD=bitte-aendern

# Welche Branche gerade läuft: energieberater, sachverstaendige.
# "werkstatt" ist Björns Testumgebung und startet im Server-Betrieb
# absichtlich NICHT.
APP_NAME=werkstatt

# ---------- Teil 2: nur für den Server ----------

# Name dieser Installation, nur Kleinbuchstaben ohne Leerzeichen, z. B.
# eb (Energieberater) oder sv (Sachverständige). Jede Installation auf dem
# Server braucht einen eigenen Namen. Er bestimmt die Namen von Containern,
# Datenbank-Volumes und Traefik-Routen. Nicht später ändern: sonst entstehen
# neue, leere Datenbanken.
INSTALLATION=

# Die Adresse, unter der die App im Internet erreichbar ist, z. B.
# app.esser-energieberatung.de. Ohne https:// davor. Der DNS-Eintrag muss
# schon auf den Server zeigen.
DOMAIN=

# E-Mail-Adresse für die Zertifikate, nur für den Fall des Caddy-Profils
# (Server ohne Traefik). Bei Traefik unbenutzt, darf leer bleiben.
ACME_EMAIL=

# Wie viele Tage lokale Backups aufbewahrt werden, ältere werden gelöscht.
BACKUP_AUFBEWAHRUNG_TAGE=14

# Zusätzlicher Ort für die Sicherung außerhalb des Servers (rsync-Ziel,
# z. B. "user@backup-server:/srv/backups"). Leer lassen = nur lokal in
# ./backups. Der Hosting-Anbieter sichert den ganzen Server täglich; ein
# eigenes Ziel ist noch offen (siehe CLAUDE.md, Abschnitt 12).
BACKUP_ZIEL=

# Optional: Backups verschlüsseln (age). Hier nur der ÖFFENTLICHE Schlüssel
# (beginnt mit age1...). Der private Schlüssel gehört nicht auf den Server.
# Leer lassen = unverschlüsselt.
BACKUP_VERSCHLUESSELUNG_SCHLUESSEL=
